#!/bin/bash

echo "🚀 Starting deploy..."

PROJECT_PATH="/var/www/iqs-framework"
cd $PROJECT_PATH || exit

# check perubahan
echo "🔍 Checking for updates..."
git fetch origin

LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/main)

if [ "$LOCAL" = "$REMOTE" ]; then
    echo "✅ No changes. Already up to date."
    exit 0
fi

echo "⬇️ Pulling latest changes..."
git pull origin main

# detect perubahan penting
CHANGES=$(git diff --name-only HEAD@{1} HEAD)

echo "📂 Changed files:"
echo "$CHANGES"

# flags
RESTART_PHP=false
RELOAD_NGINX=false

# check jenis perubahan
if echo "$CHANGES" | grep -E "\.php|\.env"; then
    RESTART_PHP=true
fi

if echo "$CHANGES" | grep -E "nginx|\.conf|ssl"; then
    RELOAD_NGINX=true
fi

# action
if [ "$RESTART_PHP" = true ]; then
    echo "🔄 Restarting PHP-FPM..."
    sudo systemctl restart php8.3-fpm
fi

if [ "$RELOAD_NGINX" = true ]; then
    echo "🔄 Reloading Nginx..."
    sudo nginx -t && sudo systemctl reload nginx
fi

echo "✅ Deploy complete!"
